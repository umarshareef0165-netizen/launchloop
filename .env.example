# Copy to .env.local and fill in your own values. Never commit real values.
# Names only here — no credential value belongs in this file, in chat, or in git.
#
# OAUTH (REQUIRED for the Buffer Commit contest — Terms §1 + §3):
# Register the app client at Buffer dashboard -> Settings -> API -> App Clients
# (publish.buffer.com/settings/api). Private/confidential client, scopes
# account:read + posts:read + posts:write + offline_access. See
# OAUTH-RESEARCH.md and DEPLOY-README.md for the exact steps.
BUFFER_CLIENT_ID=
BUFFER_CLIENT_SECRET=
# Must match a redirect URI registered on the client, character for character.
# Production: https://<your-vercel-domain>/api/auth/buffer/callback
BUFFER_REDIRECT_URI=
# Long random string that encrypts the session cookie (e.g. openssl rand -base64 32).
# If unset, the client secret is used instead (documented fallback).
BUFFER_SESSION_SECRET=
#
# PERSONAL API KEY (optional fallback for local testing only — NOT a
# substitute for OAuth in the contest):
# Buffer dashboard -> Settings -> API -> Create a new API key.
BUFFER_ACCESS_TOKEN=
